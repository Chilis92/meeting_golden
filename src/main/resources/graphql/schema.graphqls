type Dog{
    dogId: ID
    name: String
    bread: String
    color: String
    age: Int
    gender: String
    imageURL: String
    owner: Person
}

input DogInput{
    name: String
    bread: String
    color: String
    age: Int
    gender: String
    owner: PersonInput
}

type Person{
    personId: ID
    name: String
    age: Int
    gender: String
    email: String
    city: String
    phone: String
}

input PersonInput{
    name: String
    age: Int
    gender: String
    email: String
    city: String
    phone: String
}

type Query{
    findAllDogs: [Dog]!
    findDogByID(id: ID): Dog!
}

type Mutation{
    createDog(dogInput: DogInput, file: Upload): Dog
    updateDog(id: ID, dogInput: DogInput): Dog
    createPerson(personInput: PersonInput): Person
    updatePerson(id: ID, personInput: PersonInput): Person
}
